# Copy these into your environment before starting the backend.
# These values are read by application.properties via ${ENV_VAR} placeholders.
#
# IMPORTANT: The credentials previously committed to this repo are considered
# compromised. Rotate them (MongoDB user password, Brevo SMTP key, JWT secret)
# before relying on these in any shared or production environment.
#
# PowerShell (current shell only):
#   $env:MONGODB_URI = "mongodb+srv://USER:PASS@cluster0.example.mongodb.net/LordGainsBorough?retryWrites=true&w=majority"
#   $env:MAIL_USERNAME = "your-brevo-smtp-username"
#   $env:MAIL_PASSWORD = "your-brevo-smtp-password"
#   $env:JWT_SECRET = "a-long-random-secret-at-least-32-bytes"
#   .\mvnw spring-boot:run
#
# Required:
MONGODB_URI=
MAIL_USERNAME=
MAIL_PASSWORD=
JWT_SECRET=

# Optional (defaults shown):
# MONGODB_DATABASE=LordGainsBorough
# MAIL_FROM=lordgainsborough5@gmail.com
# MAIL_FROM_NAME=Lord Gainsborough
# BREVO_API_KEY=
# JWT_EXPIRATION=86400000
# MANAGEMENT_SERVER_PORT=8083
# MANAGEMENT_SERVER_ADDRESS=127.0.0.1
#
# Signup OTP secondary abuse limits (keyed IP hash + Mongo TTL counters):
# ABUSE_IP_HASH_SECRET=a-long-random-secret
# ABUSE_TRUSTED_PROXIES=127.0.0.1,::1,10.0.0.0/8
# ABUSE_INITIAL_SENDS_PER_IP=20
# ABUSE_INITIAL_SEND_WINDOW=PT15M
# ABUSE_TOTAL_SENDS_PER_IP=100
# ABUSE_TOTAL_SEND_WINDOW=PT24H
# ABUSE_VERIFICATIONS_PER_IP=60
# ABUSE_VERIFICATION_WINDOW=PT15M
# ABUSE_GLOBAL_PROVIDER_SENDS=200
# ABUSE_GLOBAL_PROVIDER_WINDOW=PT1M
# ABUSE_CAPTCHA_AFTER_INITIAL_SENDS=12
# ABUSE_CAPTCHA_ENABLED=false
# ABUSE_CAPTCHA_SHARED_TOKEN=
