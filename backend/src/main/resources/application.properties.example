# Copy these into your environment before starting the backend.
# These values are read by application.properties via ${ENV_VAR} placeholders.
#
# IMPORTANT: The credentials previously committed to this repo are considered
# compromised. Rotate them (Brevo SMTP key, JWT secret)
# before relying on these in any shared or production environment.
#
# PowerShell (current shell only):
#   $env:DB_HOST = "127.0.0.1"
#   $env:DB_NAME = "lordgainsborough_dev"
#   $env:DB_USER = "lordgainsborough"
#   $env:DB_PASSWORD = "your-local-database-password"
#   $env:MAIL_USERNAME = "your-brevo-smtp-username"
#   $env:MAIL_PASSWORD = "your-brevo-smtp-password"
#   $env:JWT_SECRET = "a-long-random-secret-at-least-32-bytes"
#   $env:ABUSE_IP_HASH_SECRET = "a-separate-long-random-secret"
#   .\mvnw spring-boot:run
#
# Required:
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
MAIL_USERNAME=
MAIL_PASSWORD=
JWT_SECRET=
ABUSE_IP_HASH_SECRET=

# Optional (defaults shown):
# PORT=8082
# APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# SOCKETIO_ORIGIN=http://localhost:3000
# DB_PORT=5432
# DB_SSL_MODE=prefer
# MAIL_FROM=lordgainsborough5@gmail.com
# MAIL_FROM_NAME=Lord Gainsborough
# BREVO_API_KEY=
# JWT_EXPIRATION=86400000
# MANAGEMENT_SERVER_PORT=8083
# MANAGEMENT_SERVER_ADDRESS=127.0.0.1
#
# Signup OTP secondary abuse limits (keyed IP hash + PostgreSQL counters):
# ABUSE_TRUSTED_PROXIES=127.0.0.1,::1,10.0.0.0/8
# ABUSE_INITIAL_SENDS_PER_IP=20
# ABUSE_INITIAL_SEND_WINDOW=PT15M
# ABUSE_TOTAL_SENDS_PER_IP=100
# ABUSE_TOTAL_SEND_WINDOW=PT24H
# ABUSE_VERIFICATIONS_PER_IP=60
# ABUSE_VERIFICATION_WINDOW=PT15M
# ABUSE_GLOBAL_PROVIDER_SENDS=200
# ABUSE_GLOBAL_PROVIDER_WINDOW=PT1M
# ABUSE_CAPTCHA_AFTER_INITIAL_SENDS=12
# ABUSE_CAPTCHA_ENABLED=false
# ABUSE_CAPTCHA_SHARED_TOKEN=
#
# Login distributed rate limits:
# LOGIN_IP_ATTEMPTS=20
# LOGIN_IP_WINDOW=PT5M
# LOGIN_IDENTIFIER_IP_FAILURES=5
# LOGIN_FAILURE_WINDOW=PT5M
# LOGIN_COOLDOWN=PT30S
#
# Password-reset challenge and distributed rate limits:
# PASSWORD_RESET_RESEND_COOLDOWN=PT30S
# PASSWORD_RESET_MAX_RESENDS=5
# PASSWORD_RESET_CODE_TTL=PT10M
# PASSWORD_RESET_CHALLENGE_TTL=PT30M
# PASSWORD_RESET_MAX_VERIFICATION_FAILURES=5
# PASSWORD_RESET_NEW_CHALLENGES_PER_EMAIL=3
# PASSWORD_RESET_NEW_CHALLENGE_WINDOW=PT1H
# PASSWORD_RESET_EMAIL_OPERATIONS_PER_IP=10
# PASSWORD_RESET_EMAIL_OPERATION_WINDOW=PT15M
# PASSWORD_RESET_VERIFICATIONS_PER_IP=30
# PASSWORD_RESET_VERIFICATION_WINDOW=PT15M
# PASSWORD_RESET_GLOBAL_EMAIL_OPERATIONS=100
# PASSWORD_RESET_GLOBAL_EMAIL_WINDOW=PT1M
# PASSWORD_RESET_SEND_LEASE=PT1M
