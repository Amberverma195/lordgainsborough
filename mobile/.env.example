EXPO_PUBLIC_API_ORIGIN=http://localhost:8082
EXPO_PUBLIC_ASSET_ORIGIN=http://localhost:8082
EXPO_PUBLIC_SOCKET_ORIGIN=http://localhost:9092

# Production Railway deployment configuration:
# Spring Boot REST API (port 8080):
# EXPO_PUBLIC_API_ORIGIN=https://api.lordgainsboroughrestaurant.ca
# EXPO_PUBLIC_ASSET_ORIGIN=https://api.lordgainsboroughrestaurant.ca
#
# Netty-SocketIO server (port 9092):
# Existing production example; independently verify routing before release:
# EXPO_PUBLIC_SOCKET_ORIGIN=https://lordgainsborough-production.up.railway.app

# EAS preview/production additionally require the existing project UUID:
# EXPO_PROJECT_ID=<existing-expo-project-uuid>
# EXPO_OWNER=<authorized-expo-team>
# Configure public HTTPS API, asset and Socket.IO origins in each EAS environment.
# Never include backend credentials or signing secrets here.

# Keep false until signed-device delivery and provider configuration are verified.
EXPO_PUBLIC_ORDER_NOTIFICATIONS_ENABLED=false
